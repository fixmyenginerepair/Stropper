{
  "name": "Sharpener",
  "properties": {
    "acquired_year": {
      "type": "number"
    },
    "blade": {
      "type": "string"
    },
    "collection": {
      "description": "Collector/member ID who owns it",
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "country": {
      "enum": [
        "Argentina",
        "Australia",
        "Australia?",
        "Austria",
        "Austria-Hungary",
        "Brazil",
        "Britian",
        "Canada",
        "Czechoslovakia",
        "Denmark",
        "England",
        "France",
        "French",
        "French?",
        "Germany",
        "Greece",
        "Holland",
        "Hungary",
        "Italy",
        "Japan",
        "Netherland",
        "Norway",
        "Other",
        "Poland",
        "Russia",
        "Russian",
        "South Africa",
        "Spain",
        "Sweden",
        "Switzerland",
        "Ukraine",
        "Unknown",
        "USA"
      ],
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "images": {
      "description": "Photo URLs, first is main",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "interview_audio_url": {
      "description": "Recording of the collector talking about this piece",
      "type": "string"
    },
    "is_double": {
      "default": false,
      "description": "Available on the swap list",
      "type": "boolean"
    },
    "legacy_id": {
      "description": "ID on the old stropper.com",
      "type": "number"
    },
    "maker_id": {
      "description": "Linked Maker record",
      "type": "string"
    },
    "manufacturer": {
      "description": "Maker and address",
      "type": "string"
    },
    "name": {
      "description": "Short name, e.g. 1-2-3 Lightning",
      "type": "string"
    },
    "patent": {
      "type": "string"
    },
    "provenance": {
      "description": "Where, when and how it was acquired; prior owners",
      "type": "string"
    },
    "rarity": {
      "enum": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8",
        "9",
        "T"
      ],
      "type": "string"
    },
    "story": {
      "description": "The story behind this piece, in the collector's words (markdown)",
      "type": "string"
    },
    "type": {
      "enum": [
        "Allegro Type",
        "Auto Strop",
        "Barber",
        "Barber Accessories",
        "Accessories",
        "Blade Holder",
        "Blade Holder & Hone",
        "Blades",
        "Circular",
        "Edge-Bak",
        "Electric",
        "Handle-like Ingersoll",
        "Handle-like Valet",
        "Hone-Carborundum",
        "Hone-Glass/Other",
        "Knife",
        "Machine-Pull Handles",
        "Magnetic",
        "Marbles-Bearings",
        "Marvel",
        "Other",
        "Pull String",
        "Razor Other",
        "Rollers-1",
        "Rollers-2",
        "Rollers-3",
        "Rollers-4",
        "Rotary Belt",
        "Safety Razor",
        "Set",
        "Sets",
        "Shake Sharp",
        "Shaving Stand",
        "Shear",
        "Straight Razor",
        "Strop",
        "Unknown"
      ],
      "type": "string"
    },
    "value": {
      "description": "Estimated value in USD",
      "type": "number"
    },
    "year_made": {
      "description": "Approximate year of manufacture, used for the timeline",
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
